+/* Match the Linux a90000.spi default pinctrl state (Cliffs TLMM):
+ * GPIO17=SE4_L1 MOSI, GPIO16=SE4_L0 MISO, GPIO18=SE4_L2 SCLK,
+ * GPIO19=SE4_L3 CS. Cliffs PINGROUP selects each first alternate function
+ * with mux value 1; the DT sets 6 mA drive and disables bias on all four.
+ */
+static void
+touch_spi_pins(void)
+{
+	touch_gpio(17, 1, 0, 2, false, false);
+	touch_gpio(16, 1, 0, 2, false, false);
+	touch_gpio(18, 1, 0, 2, false, false);
+	touch_gpio(19, 1, 0, 2, false, false);
+	printf("PERIDOT TOUCH: SE4 pinmux cfg g16=%#x g17=%#x g18=%#x g19=%#x\n",
+	    touch_rd(st.gpio16, 0), touch_rd(st.gpio17, 0),
+	    touch_rd(st.gpio18, 0), touch_rd(st.gpio19, 0));
+}
