+/* Match the vendor Berlin-D power-on handshake before reading IC info. */
+static int
+touch_goodix_confirm(void)
+{
+	static const uint8_t confirm[8] = { 0xaa, 0xaa, 0xaa, 0xaa,
+	    0xaa, 0xaa, 0xaa, 0xaa };
+	uint8_t response[sizeof(confirm)];
+	for (unsigned retry = 0; retry < 3; ++retry) {
+		int err = touch_write(GOODIX_BOOTOPTION_ADDR, confirm, sizeof(confirm));
+		if (!err) {
+			err = touch_read(GOODIX_BOOTOPTION_ADDR, response, sizeof(response));
+		}
+		if (!err && memcmp(confirm, response, sizeof(confirm)) == 0) {
+			return 0;
+		}
+		touch_wait(5);
+	}
+	return EIO;
+}
